# Supabase project (same project as urban-explorer-ai — ref wqsdtdvkqssjjucwjxgv)
SUPABASE_URL=https://wqsdtdvkqssjjucwjxgv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Must match the CREWAI_INGEST_SECRET Supabase edge function secret exactly —
# get the current value with:
#   SUPABASE_ACCESS_TOKEN=<token> npx supabase secrets list --project-ref wqsdtdvkqssjjucwjxgv
CREWAI_INGEST_SECRET=

# Bearer token this service itself requires on POST /kickoff. Generate any
# strong random value, then set the SAME value as the CREWAI_KICKOFF_TOKEN
# Supabase edge function secret so crewai-trigger-refresh's calls are accepted:
#   SUPABASE_ACCESS_TOKEN=<token> npx supabase secrets set CREWAI_KICKOFF_TOKEN=<value> --project-ref wqsdtdvkqssjjucwjxgv
CREWAI_KICKOFF_TOKEN=

# Same Anthropic key already used by the app's own edge functions (chat,
# hiking-routes) — get it from `supabase secrets list` if you don't have it.
ANTHROPIC_API_KEY=
